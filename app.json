{
  "expo": {
    "name": "KittyAI",
    "slug": "pi-app",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meister.piapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSMicrophoneUsageDescription": "KittyAI braucht das Mikrofon für den Sprachmodus (Diktieren).",
        "NSSpeechRecognitionUsageDescription": "KittyAI nutzt Spracherkennung, damit du Nachrichten diktieren kannst."
      },
      "buildNumber": "133",
      "appleTeamId": "VW2SBC8228",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.meister.piapp"
        ],
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.meister.piapp",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "KittyAI braucht Zugriff auf deine Fotos, damit du Bilder anhängen kannst.",
          "cameraPermission": "KittyAI braucht die Kamera, damit du ein Foto direkt aufnehmen und anhängen kannst."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "KittyAI braucht das Mikrofon für den Sprachmodus (Diktieren).",
          "speechRecognitionPermission": "KittyAI nutzt Spracherkennung, damit du Nachrichten diktieren kannst."
        }
      ],
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "assets/fonts/AnthropicSerifMobileVariable-TextRegular.ttf",
            "assets/fonts/AnthropicSerifMobileVariable-TextRegularItalic.ttf",
            "assets/fonts/AnthropicSansMobileVariable-TextRegular.ttf",
            "assets/fonts/AnthropicSansMobileVariable-TextRegularItalic.ttf",
            "assets/fonts/JetBrainsMono-Regular.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "1f2cda59-ed40-4415-9d1f-fa2f5fe5ac5b"
      }
    },
    "owner": "per_h",
    "scheme": "kittyai",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1f2cda59-ed40-4415-9d1f-fa2f5fe5ac5b"
    }
  }
}